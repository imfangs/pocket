    "i18next": "26.7.1",
    "idb": "8.0.4",
    "lucide-react": "^0.468.0",
    "mdast-util-from-markdown": "2.0.3",
    "modern-screenshot": "4.7.0",
    "pele": "file:vendor/pele/pele-1.6.0-pocket.44da152.tgz",
