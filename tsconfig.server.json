{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "shared/submission-contracts.ts",
    "server/dispatch-response.mjs",
    "server/execution-stops.mjs",
    "server/attachment-upload-validation.mjs",
    "tests/types/server-contracts.ts"
  ]
}
